# Copy to .env and adjust. .env is git-ignored.
# SSH host (as in ~/.ssh/config) of the web server
HOST=my-server
# Directory on the server that is served by the web server
REMOTE_DIR=/srv/web/waste
# Directory on the server for backups of replaced files (outside the public folder)
BACKUP_ROOT=/srv/web
# Public base URL under which the files are served
URL=https://example.com/waste
